# Copy to .env (or set these in your host's dashboard). Never commit the real .env.

# Todoist: Settings > Integrations > Developer > API token
TODOIST_API_TOKEN=

# A passcode the app asks for once per phone, so a stranger with the URL can't add tasks.
APP_PASSCODE=

# --- AI provider (any OpenAI-compatible API) ---
# Default: Groq free tier (one key covers both transcription and task splitting).
# Get a key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# Set to false if your model/provider rejects response_format=json_object
LLM_JSON_MODE=true

# Swap examples (change the three LLM_ lines; keep STT_ pointed at Groq):
#   OpenRouter free:  LLM_BASE_URL=https://openrouter.ai/api/v1          LLM_MODEL=<any model id ending in :free>
#   Zhipu GLM:        LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4.5-flash
#   Moonshot Kimi:    LLM_BASE_URL=https://api.moonshot.ai/v1            LLM_MODEL=kimi-k2-0905-preview
#   Local Ollama:     LLM_BASE_URL=http://localhost:11434/v1             LLM_MODEL=qwen2.5:7b  LLM_API_KEY=ollama

# --- Speech to text (OpenAI-compatible /audio/transcriptions) ---
# Commented out = reuse the LLM_ settings above (fine while on Groq).
# When you switch the LLM to GLM/Kimi/etc, uncomment these and put your Groq key here,
# since those providers don't offer Whisper transcription.
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_API_KEY=
# STT_MODEL=whisper-large-v3-turbo

PORT=3000
