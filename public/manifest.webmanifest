{
  "id": "/",
  "name": "Todoist Jotter",
  "short_name": "Jotter",
  "description": "Speak a note, get Todoist tasks.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#E0483B",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Record a note", "short_name": "Record", "url": "/", "icons": [{ "src": "/icon-maskable-192.png", "sizes": "192x192" }] },
    { "name": "Type a note", "short_name": "Type", "url": "/?type=1", "icons": [{ "src": "/icon-maskable-192.png", "sizes": "192x192" }] }
  ]
}
